{
  "name": "pixai-desktop",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "tsc -b && tsc -p tsconfig.electron.json && vite build && node scripts/build-electron.mjs",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc -b && tsc -p tsconfig.electron.json",
    "server": "node --env-file=.env --use-env-proxy --watch server/index.ts",
    "dev:web": "vite",
    "start": "electron .",
    "package": "npm run build && electron-builder --mac dir",
    "dist:mac": "npm run build && electron-builder --mac dmg",
    "postinstall": "node node_modules/electron/install.js",
    "test:runtime": "node scripts/build-electron.mjs && electron scripts/smoke-electron.mjs",
    "test:recovery": "npm run build && electron scripts/check-worker-recovery.mjs"
  },
  "dependencies": {
    "@ai-sdk/openai": "^4.0.111",
    "@ai-sdk/openai-compatible": "^3.0.85",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@electron-toolkit/preload": "^3.0.2",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/nunito": "^5.3.0",
    "@react-three/drei": "10.7.9",
    "@react-three/fiber": "9.8.1",
    "@tiptap/extension-mention": "^3.31.4",
    "@tiptap/extension-placeholder": "^3.31.4",
    "@tiptap/pm": "^3.31.4",
    "@tiptap/react": "^3.31.4",
    "@tiptap/starter-kit": "^3.31.4",
    "@tiptap/suggestion": "^3.31.4",
    "@types/proper-lockfile": "^4.1.4",
    "ai": "^7.0.163",
    "better-sqlite3": "^13.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.4.0",
    "dotenv": "^18.0.9",
    "fastify": "5.12.5",
    "i18next": "^26.4.3",
    "jose": "^6.2.17",
    "lucide-react": "^1.55.0",
    "openai": "^7.54.0",
    "proper-lockfile": "^4.1.2",
    "radix-ui": "^1.8.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-i18next": "^17.0.16",
    "react-markdown": "^10.1.0",
    "shadcn": "^4.21.4",
    "tailwind-merge": "^3.7.0",
    "three": "0.186.1",
    "undici": "^8.12.4",
    "vaul": "^1.1.2",
    "zod": "^4.6.7",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@types/three": "0.186.0",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.6",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2",
    "oxlint": "^1.81.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "tw-animate-css": "^1.4.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.3",
    "wait-on": "^9.5.1"
  },
  "main": "dist-electron/main.js",
  "description": "Local PixAI creative workbench with a persistent agent",
  "build": {
    "appId": "art.pixai.desktop",
    "productName": "PixAI Desktop",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json",
      "LICENSE",
      "electron/vendor/siwc/LICENSE",
      "electron/vendor/siwc/THIRD_PARTY_NOTICES.md"
    ],
    "asarUnpack": [
      "node_modules/better-sqlite3/**"
    ],
    "mac": {
      "category": "public.app-category.graphics-design",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ]
    }
  },
  "license": "MIT"
}
